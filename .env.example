# Frontend (Vite) — copy to .env.local and fill in.
# Clerk publishable key (pk_test_... for dev, pk_live_... for production). Required.
VITE_CLERK_PUBLISHABLE_KEY=
# Base URL of the jatimetri-api Worker. Falls back to http://localhost:8787 when unset.
VITE_API_URL=http://localhost:8787

# Worker secret — do NOT put it here. For local dev put it in .dev.vars,
# in production run: wrangler secret put CLERK_SECRET_KEY --env production
# CLERK_SECRET_KEY=
